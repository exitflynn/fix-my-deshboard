# Copy to .env and fill in.
DOMAIN=localhost                  # e.g. babu-log.in in production
BASE_URL=http://localhost:8080    # public URL; https://<domain> in production
POSTGRES_PASSWORD=change-me

# Usernames (chosen on first login) that get admin rights, comma-separated.
ADMIN_USERS=

# Google sign-in: create an OAuth client (Web application) in Google Cloud Console
# with redirect URI $BASE_URL/auth/callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Local development only: log in as any name without Google. Refused with an https BASE_URL.
DEV_LOGIN=1

BACKUP_REMOTE=                    # rclone remote, e.g. r2:babu-log-backups
